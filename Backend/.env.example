# Server
PORT=8080
APP_ENV=development
LOG_LEVEL=debug

# HTTP Basic Auth (protects /api/*)
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=change-me

# Solana
SOLANA_RPC=https://api.devnet.solana.com
SOLANA_WS=wss://api.devnet.solana.com
PROGRAM_ID=11111111111111111111111111111111

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/blockchain101

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
